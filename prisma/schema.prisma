generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { ADMIN CASHIER }
enum PaymentMethod { CASH CARD BANK WALLET }
enum StockType { PURCHASE SALE RETURN ADJUSTMENT PURCHASE_RETURN DAMAGED EXPIRED }
enum PurchaseStatus { PENDING COMPLETED CANCELLED }
enum PurchasePaymentType { CASH CREDIT }

model User {
  id Int @id @default(autoincrement())
  name String
  username String @unique
  passwordHash String
  role Role @default(CASHIER)
  // True only for the original/root admin account. That one account can never be
  // demoted or deleted by anyone, so the shop can never lock itself out of Admin
  // access. Every other account — even ones later promoted to ADMIN — stays fully
  // upgradable/downgradable by an admin at any time.
  isProtected Boolean @default(false)
  sales Sale[]
  purchasesCreated Purchase[] @relation("PurchaseCreatedBy")
  stockTransactions StockTransaction[]
  createdAt DateTime @default(now())
}

model ShopSettings {
  id Int @id @default(1)
  name String @default("My Pharmacy")
  panVat String?
  regNo String?
  email String?
  address String?
  phone String?
  logoUrl String?
  allowExpiredSales Boolean @default(false)
  vatRate Float @default(0)
}

model Medicine {
  id Int @id @default(autoincrement())
  name String
  genericName String?
  manufacturer String?
  category String?
  dosageForm String?
  strength String?
  unit String @default("unit")
  sku String @unique
  barcode String? @unique
  minStock Int @default(0)
  reorderLevel Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  batches MedicineBatch[]
  saleItems SaleItem[]
  purchaseItems PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  stockTransactions StockTransaction[]
}

model MedicineBatch {
  id Int @id @default(autoincrement())
  medicineId Int
  batchNumber String
  purchaseRate Float
  sellingRate Float
  quantity Int @default(0)
  expiryDate DateTime
  supplierId Int?
  medicine Medicine @relation(fields:[medicineId], references:[id], onDelete: Cascade)
  supplier Supplier? @relation(fields:[supplierId], references:[id], onDelete: SetNull)
  stockTransactions StockTransaction[]
  saleItems SaleItem[]
  purchaseItems PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  @@unique([medicineId,batchNumber])
}

model Supplier {
  id Int @id @default(autoincrement())
  name String
  company String?
  contactPerson String?
  phone String?
  address String?
  email String?
  // Legacy combined PAN/VAT field, kept so existing data/prints keep working.
  panVat String?
  // New, separately-tracked identifiers (requirement: PAN, VAT, registration number).
  pan String?
  vatNo String?
  regNo String?
  paymentTerms String?
  openingBalance Float @default(0)
  notes String?
  isActive Boolean @default(true)
  dueAmount Float @default(0)
  createdAt DateTime @default(now())
  batches MedicineBatch[]
  purchases Purchase[]
  payments SupplierPayment[]
  purchaseReturns PurchaseReturn[]
  stockTransactions StockTransaction[]
}

model Customer {
  id Int @id @default(autoincrement())
  name String
  phone String?
  address String?
  email String?
  panVat String?
  openingBalance Float @default(0)
  isActive Boolean @default(true)
  dueAmount Float @default(0)
  createdAt DateTime @default(now())
  sales Sale[]
  payments CustomerPayment[]
  stockTransactions StockTransaction[]
}

model SupplierPayment {
  id Int @id @default(autoincrement())
  supplierId Int
  purchaseId Int?
  amount Float
  note String?
  paidDate DateTime @default(now())
  supplier Supplier @relation(fields:[supplierId], references:[id], onDelete:Cascade)
  purchase Purchase? @relation(fields:[purchaseId], references:[id], onDelete:SetNull)
}

model CustomerPayment {
  id Int @id @default(autoincrement())
  customerId Int
  saleId Int?
  amount Float
  note String?
  paidDate DateTime @default(now())
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Cascade)
  sale Sale? @relation(fields:[saleId], references:[id], onDelete:SetNull)
}

model Purchase {
  id Int @id @default(autoincrement())
  supplierId Int?
  invoiceNo String?
  purchaseDate DateTime @default(now())
  status PurchaseStatus @default(COMPLETED)
  subtotal Float @default(0)
  discountAmount Float @default(0)
  vatAmount Float @default(0)
  totalAmount Float
  paidAmount Float @default(0)
  // Cash (paid in full/part now) vs Credit (owed to the vendor). Each carries its
  // own date: paidDate is when cash actually changed hands; creditDueDate is when a
  // credit purchase is expected to be settled.
  paymentType PurchasePaymentType @default(CASH)
  paidDate DateTime?
  creditDueDate DateTime?
  // Scanned/photographed supplier invoice, stored as a data URL (same pattern as
  // ShopSettings.logoUrl) so a purchase's source document travels with the record.
  invoiceFileUrl String?
  invoiceFileName String?
  notes String?
  createdById Int?
  supplier Supplier? @relation(fields:[supplierId], references:[id], onDelete:SetNull)
  createdBy User? @relation("PurchaseCreatedBy", fields:[createdById], references:[id], onDelete:SetNull)
  items PurchaseItem[]
  payments SupplierPayment[]
  stockTransactions StockTransaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([supplierId, invoiceNo])
}

model PurchaseReturn {
  id Int @id @default(autoincrement())
  supplierId Int?
  purchaseId Int?
  returnDate DateTime @default(now())
  reason String?
  totalAmount Float
  supplier Supplier? @relation(fields:[supplierId], references:[id], onDelete:SetNull)
  items PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id Int @id @default(autoincrement())
  returnId Int
  medicineId Int
  batchId Int
  quantity Int
  purchaseRate Float
  amount Float
  return PurchaseReturn @relation(fields:[returnId], references:[id], onDelete:Cascade)
  medicine Medicine @relation(fields:[medicineId], references:[id])
  batch MedicineBatch @relation(fields:[batchId], references:[id])
}

model PurchaseItem {
  id Int @id @default(autoincrement())
  purchaseId Int
  medicineId Int
  batchId Int
  quantity Int
  freeQuantity Int @default(0)
  purchaseRate Float
  // Selling rate set for the batch at the time of this purchase (snapshot; the batch's
  // *current* sellingRate can move on later purchases without rewriting this history row).
  sellingRate Float @default(0)
  discount Float @default(0)
  vat Float @default(0)
  amount Float @default(0)
  purchase Purchase @relation(fields:[purchaseId], references:[id], onDelete:Cascade)
  medicine Medicine @relation(fields:[medicineId], references:[id])
  batch MedicineBatch @relation(fields:[batchId], references:[id])
}

model Sale {
  id Int @id @default(autoincrement())
  invoiceNo String @unique
  saleDate DateTime @default(now())
  customerId Int?
  cashierId Int
  subtotal Float
  discount Float @default(0)
  tax Float @default(0)
  total Float
  paid Float
  change Float
  paymentMethod PaymentMethod
  cancelled Boolean @default(false)
  customer Customer? @relation(fields:[customerId], references:[id], onDelete:SetNull)
  cashier User @relation(fields:[cashierId], references:[id])
  items SaleItem[]
  payments CustomerPayment[]
  stockTransactions StockTransaction[]
}

model SaleItem {
  id Int @id @default(autoincrement())
  saleId Int
  medicineId Int
  batchId Int
  quantity Int
  sellingRate Float
  purchaseRate Float
  discount Float @default(0)
  amount Float
  sale Sale @relation(fields:[saleId], references:[id], onDelete:Cascade)
  medicine Medicine @relation(fields:[medicineId], references:[id])
  batch MedicineBatch @relation(fields:[batchId], references:[id])
  returnItems ReturnItem[]
}

model Return {
  id Int @id @default(autoincrement())
  saleId Int
  returnDate DateTime @default(now())
  reason String?
  totalAmount Float
  items ReturnItem[]
  sale Sale @relation(fields:[saleId], references:[id])
}

model ReturnItem {
  id Int @id @default(autoincrement())
  returnId Int
  saleItemId Int
  quantity Int
  amount Float
  return Return @relation(fields:[returnId], references:[id], onDelete:Cascade)
  saleItem SaleItem @relation(fields:[saleItemId], references:[id])
}

// Every physical stock movement, of any kind, is recorded here. This is the single
// source of truth for "Medicine Stock History" (requirement #8): it always carries
// which medicine and batch moved, why (type + reference/purchase/sale link), who
// triggered it, and the resulting balance — never hand-typed, always derived from
// the transaction that caused it.
model StockTransaction {
  id Int @id @default(autoincrement())
  medicineId Int?
  batchId Int
  type StockType
  quantity Int
  quantityIn Int @default(0)
  quantityOut Int @default(0)
  balanceAfter Int?
  reference String?
  supplierId Int?
  customerId Int?
  purchaseId Int?
  saleId Int?
  userId Int?
  createdAt DateTime @default(now())
  medicine Medicine? @relation(fields:[medicineId], references:[id], onDelete:SetNull)
  batch MedicineBatch @relation(fields:[batchId], references:[id], onDelete:Cascade)
  supplier Supplier? @relation(fields:[supplierId], references:[id], onDelete:SetNull)
  customer Customer? @relation(fields:[customerId], references:[id], onDelete:SetNull)
  purchase Purchase? @relation(fields:[purchaseId], references:[id], onDelete:SetNull)
  sale Sale? @relation(fields:[saleId], references:[id], onDelete:SetNull)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
}
